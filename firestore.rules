rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Users can only access their own user document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      // Allow reading user documents for search purposes (limited fields)
      allow read: if request.auth != null && 
        request.query.limit <= 10;
      
      // Device tokens subcollection - users can manage their own device tokens
      match /deviceTokens/{tokenId} {
        allow read, write, delete: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // User profiles - users can only access their own profile
    match /userProfiles/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // User stats - users can only access their own stats
    match /userStats/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Notifications - users can only access their own notifications
    match /notifications/{notificationId} {
      allow read, write: if request.auth != null && 
        request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && 
        request.auth.uid == request.resource.data.userId;
    }
    
    // Notification reactions - users can manage reactions on notifications they can access
    match /notificationReactions/{reactionId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && 
        request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && 
        request.auth.uid == request.resource.data.userId;
    }
    
    // Boards - users can only access boards they are members of
    match /boards/{boardId} {
      allow read, write: if request.auth != null && 
        (request.auth.uid in resource.data.memberIds ||
         request.auth.uid == resource.data.ownerId);
      allow create: if request.auth != null && 
        request.auth.uid == request.resource.data.ownerId &&
        request.auth.uid in request.resource.data.memberIds;
    }
    
    // Tasks - users can only access tasks in boards they are members of
    match /tasks/{taskId} {
      allow read, write: if request.auth != null && 
        exists(/databases/$(database)/documents/boards/$(resource.data.boardId)) &&
        request.auth.uid in get(/databases/$(database)/documents/boards/$(resource.data.boardId)).data.memberIds;
      allow create: if request.auth != null && 
        exists(/databases/$(database)/documents/boards/$(request.resource.data.boardId)) &&
        request.auth.uid in get(/databases/$(database)/documents/boards/$(request.resource.data.boardId)).data.memberIds;
    }
    
    // Task comments - users can only access comments on tasks they have access to
    match /taskComments/{commentId} {
      allow read: if request.auth != null && 
        exists(/databases/$(database)/documents/tasks/$(resource.data.taskId)) &&
        exists(/databases/$(database)/documents/boards/$(get(/databases/$(database)/documents/tasks/$(resource.data.taskId)).data.boardId)) &&
        request.auth.uid in get(/databases/$(database)/documents/boards/$(get(/databases/$(database)/documents/tasks/$(resource.data.taskId)).data.boardId)).data.memberIds;
      allow write: if request.auth != null && 
        request.auth.uid == resource.data.authorId;
      allow create: if request.auth != null && 
        request.auth.uid == request.resource.data.authorId &&
        exists(/databases/$(database)/documents/tasks/$(request.resource.data.taskId)) &&
        exists(/databases/$(database)/documents/boards/$(get(/databases/$(database)/documents/tasks/$(request.resource.data.taskId)).data.boardId)) &&
        request.auth.uid in get(/databases/$(database)/documents/boards/$(get(/databases/$(database)/documents/tasks/$(request.resource.data.taskId)).data.boardId)).data.memberIds;
    }
    
    // Inbox items - users can only access their own inbox items
    match /inboxItems/{itemId} {
      allow read, write: if request.auth != null && 
        request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && 
        request.auth.uid == request.resource.data.userId;
    }
    
    // Invites - public read for joining, but only board members can create
    match /invites/{inviteCode} {
      allow read: if true; // Anyone can read invites to join boards
      allow create: if request.auth != null;
      allow delete: if request.auth != null;
    }
    
    // Direct invitations - users can only see invitations sent to them
    match /directInvitations/{invitationId} {
      allow read: if request.auth != null && 
        (request.auth.uid == resource.data.toUserId || 
         request.auth.uid == resource.data.fromUserId);
      allow create: if request.auth != null && 
        request.auth.uid == request.resource.data.fromUserId;
      allow update: if request.auth != null && 
        request.auth.uid == resource.data.toUserId;
    }
    
    // Board invitations - users can manage invitations for boards they own or are members of
    match /boardInvitations/{invitationId} {
      allow read: if request.auth != null && 
        (request.auth.uid == resource.data.inviterId || 
         request.auth.uid == resource.data.inviteeId ||
         exists(/databases/$(database)/documents/boards/$(resource.data.boardId)) &&
         request.auth.uid in get(/databases/$(database)/documents/boards/$(resource.data.boardId)).data.memberIds);
      allow create: if request.auth != null && 
        request.auth.uid == request.resource.data.inviterId;
      allow update: if request.auth != null && 
        (request.auth.uid == resource.data.inviterId || 
         request.auth.uid == resource.data.inviteeId);
    }
    
    // Board activities - users can read activities for boards they are members of
    match /boardActivities/{activityId} {
      allow read: if request.auth != null && 
        exists(/databases/$(database)/documents/boards/$(resource.data.boardId)) &&
        request.auth.uid in get(/databases/$(database)/documents/boards/$(resource.data.boardId)).data.memberIds;
      allow create: if request.auth != null && 
        request.auth.uid == request.resource.data.userId &&
        exists(/databases/$(database)/documents/boards/$(request.resource.data.boardId)) &&
        request.auth.uid in get(/databases/$(database)/documents/boards/$(request.resource.data.boardId)).data.memberIds;
    }
    
    // User presence - users can read presence for boards they are members of
    match /userPresence/{presenceId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && 
        request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && 
        request.auth.uid == request.resource.data.userId;
    }
    
    // Store items - public read access for all authenticated users
    match /storeItems/{itemId} {
      allow read: if request.auth != null;
      allow write: if false; // Only admins should write store items
    }
    
    // User purchases - users can only access their own purchases
    match /purchases/{purchaseId} {
      allow read, write: if request.auth != null && 
        request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && 
        request.auth.uid == request.resource.data.userId;
    }
    
    // User inventories - users can only access their own inventory
    match /userInventories/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // User stats for gamification - users can only access their own stats
    match /userStats/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Invitations (for rewards/referral system) - users can manage invitations they send or receive
    match /invitations/{invitationId} {
      allow read: if request.auth != null && 
        (request.auth.uid == resource.data.inviterId || 
         request.auth.uid == resource.data.inviteeId);
      allow create: if request.auth != null && 
        request.auth.uid == request.resource.data.inviterId;
      allow update: if request.auth != null && 
        (request.auth.uid == resource.data.inviterId || 
         request.auth.uid == resource.data.inviteeId);
    }
    
    // Referral bonuses - users can only see their own referral bonuses
    match /referralBonuses/{bonusId} {
      allow read, write: if request.auth != null && 
        request.auth.uid == resource.data.inviterId;
      allow create: if request.auth != null && 
        request.auth.uid == request.resource.data.inviterId;
    }
    
    // Subscriptions - users can only access their own subscription
    match /subscriptions/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // User limitations - users can only access their own limitations
    match /user_limitations/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Subscription products - public read access for all authenticated users
    match /subscription_products/{productId} {
      allow read: if request.auth != null;
      allow write: if false; // Only admins should write products
    }
    
    // Activities - users can only access their own activities
    match /activities/{activityId} {
      allow read, write: if request.auth != null && 
        request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && 
        request.auth.uid == request.resource.data.userId;
    }
  }
}
